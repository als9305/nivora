# Environment configuration for DeepGuard Backend
APP_NAME=DeepGuard
ENV=development
DEBUG=True
PORT=8000

# Security & Secrets
JWT_SECRET=deepguard_super_secret_hackathon_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=deepguard_db
USE_IN_MEMORY_DB_FALLBACK=True

# LLM Explanation Agent (Optional)
GEMINI_API_KEY=

# Model Configuration
FACE_MATCH_THRESHOLD=0.60
DEEPFAKE_THRESHOLD=0.50
VOICE_MATCH_THRESHOLD=0.55

# Risk Score Thresholds (0 - 100)
RISK_THRESHOLD_LOW=35
RISK_THRESHOLD_MEDIUM=70

# Risk Engine Weights (Must sum to 1.0)
WEIGHT_FACE=0.20
WEIGHT_LIVENESS=0.25
WEIGHT_DEEPFAKE=0.30
WEIGHT_VOICE=0.15
WEIGHT_DEVICE=0.10
